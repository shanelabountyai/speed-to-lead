      "parameters": {
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/drafts?maxResults=500&q=to:example.com%20%22Tallgrass%20Advisory%22",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2"
      },
      "name": "List demo drafts",
      "type": "n8n-nodes-base.httpRequest",
