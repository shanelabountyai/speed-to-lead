        "gmailOAuth2": {
          "id": "GGGxY4DRdE9giH2x",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return ($json.drafts ?? []).map(d => ({ json: { id: d.id } }));"
      },
      "name": "Split drafts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://gmail.googleapis.com/gmail/v1/users/me/drafts/{{ $json.id }}?format=metadata&metadataHeaders=To",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2"
      },
      "name": "Draft headers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "GGGxY4DRdE9giH2x",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const to = (it.json.message?.payload?.headers ?? []).find(h => h.name.toLowerCase() === 'to')?.value ?? '';\n  const addrs = to.split(',').map(a => (a.match(/<([^>]+)>/)?.[1] ?? a).trim().toLowerCase()).filter(Boolean);\n  if (addrs.length && addrs.every(a => a.endsWith('@example.com'))) out.push({ json: { id: it.json.id, to } });\n}\nreturn out;"
      },
      "name": "Only example.com",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
