        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filterGroups: [{ filters: [{ propertyName: 'createdate', operator: 'GTE', value: String(Date.now() - 24*3600*1000) }] }], properties: ['email','firstname','lastname','company'], sorts: [{ propertyName: 'createdate', direction: 'DESCENDING' }], limit: 100 }) }}"
      },
      "name": "Search new contacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
