              "type": "string"
            },
            {
              "id": "a3",
              "name": "time_to_draft_s",
              "value": "={{ $('Shape and throttle').item.json.time_to_draft_s }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "cost_usd",
              "value": "={{ $('Shape and throttle').item.json.cost_usd }}",
              "type": "number"
            },
            {
              "id": "a5",
              "name": "error",
              "value": "={{ $('Shape and throttle').item.json.error }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Error row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "n1RunLogWriter01",
          "mode": "id"
        },
        "options": {}
      },
      "name": "Log the failure",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1200,
        0
      ],
      "onError": "continueRegularOutput"
    }
  ],
