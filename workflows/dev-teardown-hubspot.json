        "jsCode": "const inputs = [...new Set(($json.results ?? []).flatMap(r => r.to.map(t => String(t.toObjectId))))].map(id => ({ id }));\nreturn inputs.length ? [{ json: { inputs } }] : [{ json: { inputs: [] } }];"
