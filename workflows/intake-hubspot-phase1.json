        "hubspotAppToken": {
          "id": "u1WBi64R7zas6Zfn",
          "name": "HubSpot Service Key account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "1tf-R3Nx1leSg4i4rBwCq8XzItWzUk-qID06-js_AOcY",
