{
  "id": "n1ErrorHandler01",
  "name": "Spine: error handler",
  "nodes": [
    {
      "parameters": {},
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// ponytail: one alert EMAIL per 15 min via static data, so an outage cannot mail every minute; every failure is still logged. Per-source throttling if that proves too coarse.\nconst s = $getWorkflowStaticData('global');\nconst now = Date.now();\nconst send = !(s.lastAlert && now - s.lastAlert < 15 * 60 * 1000);\nif (send) s.lastAlert = now;\nconst e = $json;\nreturn [{ json: {\n  send,\n  source: e.workflow?.name ?? 'unknown',\n  source_id: 'execution ' + (e.execution?.id ?? '?'),\n  outcome: 'error',\n  time_to_draft_s: '', cost_usd: 0,\n  error: (e.execution?.lastNodeExecuted ?? '?') + ': ' + (e.execution?.error?.message ?? 'unknown'),\n  subject: 'n8n alert: ' + (e.workflow?.name ?? 'workflow') + ' failed at ' + (e.execution?.lastNodeExecuted ?? '?'),\n}}];"
      },
      "name": "Shape and throttle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.send }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Send alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "__ALERT_TO__",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "=Run: {{ $json.source }}\nStep and error: {{ $json.error }}\nInput: {{ $json.source_id }}",
        "options": {
          "appendAttribution": false
        }
      },
      "name": "Alert owner",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        720,
        -80
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "GGGxY4DRdE9giH2x",
          "name": "Gmail account"
        }
      },
      "retryOnFail": false
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "source",
              "value": "={{ $('Shape and throttle').item.json.source }}",
              "type": "string"
            },
            {
              "id": "a1",
              "name": "source_id",
              "value": "={{ $('Shape and throttle').item.json.source_id }}",
              "type": "string"
            },
            {
              "id": "a2",
